{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulador-interacoes/schemas/domain.schema.json",
  "title": "Entidades de domínio",
  "description": "Fonte única do modelo de dados. Tipos TypeScript são gerados a partir daqui. Ver docs/01-GLOSSARIO.md para o significado canônico de cada termo.",

  "$defs": {

    "Vec2": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },

    "GridPos": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } },
      "additionalProperties": false
    },

    "Material": {
      "type": "object",
      "description": "Entrada do catálogo único de matéria. Cobre tanto materiais do mundo — carvalho, ferro, vidro — quanto tecidos do corpo — pele, músculo, osso, órgão, nervo. Não existe segundo catálogo: 'osso' é uma entrada só, e serve para um porrete e para um fêmur. É essa unificação que permite ao GM transmutar o material de uma parte do corpo sem código novo. W-011, B-003, B-038.",
      "required": ["id", "name", "category", "description", "properties", "numeric"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["material", "element"],
          "description": "Material é matéria estável; elemento é condição instável. A matriz de reação só admite elemento→material, elemento→elemento, nunca material→material. R-002, R-003."
        },
        "description": { "type": "string", "description": "Texto enviado ao GM para decisões nuançadas. W-014." },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Etiquetas arbitrárias além das booleanas. Regras do substrato e da matriz de lesão referenciam etiquetas, nunca identificadores de material. R-001, B-020. Etiquetas com significado biológico: 'tissue' — pode compor uma parte do corpo por padrão; 'living' — cicatriza, apodrece e adoece, e sua ausência faz a parte se comportar como objeto; 'vascular' — sangra ao ser ferida e aceita o vetor de injeção. B-003."
        },
        "properties": {
          "type": "object",
          "description": "Etiquetas booleanas canônicas, com efeito determinístico na engine. W-012.",
          "properties": {
            "inflammable": { "type": "boolean" },
            "waterSensitive": { "type": "boolean" },
            "conductive": { "type": "boolean" },
            "sharp": { "type": "boolean" },
            "toxic": { "type": "boolean" },
            "edible": { "type": "boolean" },
            "potable": { "type": "boolean" },
            "fragile": { "type": "boolean" },
            "buoyant": { "type": "boolean" },
            "insulating": { "type": "boolean" },
            "transparent": { "type": "boolean" },
            "magnetic": { "type": "boolean" },
            "organic": { "type": "boolean" },
            "slippery": { "type": "boolean" },
            "absorbent": { "type": "boolean" },
            "corrosive": { "type": "boolean" },
            "luminous": { "type": "boolean" },
            "soundproof": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "numeric": {
          "type": "object",
          "description": "W-013.",
          "properties": {
            "hardness": { "type": "number", "minimum": 0, "maximum": 10 },
            "density": { "type": "number" },
            "specificHeat": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Resistência a mudar de temperatura. A cada tick a entidade move sua temperatura em direção ao ambiente pela diferença dividida por este valor. R-008."
            },
            "decayRate": { "type": "number", "description": "Perda de integridade por dia simulado." },
            "flammabilitySpeed": { "type": "number" },
            "nutritionValue": { "type": "number" },
            "toxicity": { "type": "number", "minimum": 0, "maximum": 10 },
            "bleedFactor": { "type": "number", "minimum": 0, "description": "Multiplicador de sangramento quando este material compõe uma parte ferida. Só faz sentido em materiais com a etiqueta 'vascular'. B-017." }
          },
          "additionalProperties": false
        },
        "thermal": {
          "type": "object",
          "description": "Limiares térmicos. Todos opcionais: um ausente significa que a transição nunca ocorre por temperatura. Substituem reações discretas de derreter, congelar, ferver e incendiar. R-009.",
          "properties": {
            "brittlePoint": { "type": "number" },
            "freezePoint": { "type": "number" },
            "meltPoint": { "type": "number" },
            "boilPoint": { "type": "number" },
            "ignitePoint": { "type": "number" },
            "heatDamagePoint": { "type": "number" },
            "coldDamagePoint": { "type": "number" },
            "fixedTemperature": {
              "type": "number",
              "description": "Quando presente, a temperatura é imune à convergência. R-010."
            }
          },
          "additionalProperties": false
        },
        "damageResistance": {
          "type": "object",
          "description": "Resistência por tipo de dano, 0 a 1. R-027.",
          "properties": {
            "impact": { "type": "number", "minimum": 0, "maximum": 1 },
            "cut": { "type": "number", "minimum": 0, "maximum": 1 },
            "fire": { "type": "number", "minimum": 0, "maximum": 1 },
            "corrosion": { "type": "number", "minimum": 0, "maximum": 1 },
            "electric": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "rubbleMaterialId": {
          "type": "string",
          "description": "No que se transforma ao ter integridade zerada. R-027."
        },
        "meltsTo": { "type": "string" },
        "freezesTo": { "type": "string" },
        "boilsTo": { "type": "string" },
        "burnsTo": { "type": "string" },
        "_nota": { "type": "string", "description": "Comentário livre no arquivo de dados. Ignorado pela engine." }
      },
      "additionalProperties": false
    },

    "TransientState": {
      "type": "object",
      "required": ["type", "intensity"],
      "description": "Condição transitória sobre tile, objeto ou criatura. Várias coexistem e cada uma decai no seu ritmo. R-004.",
      "properties": {
        "type": { "type": "string", "description": "burning, wet, frozen, electrified, slippery, contaminated, smoky, stained." },
        "intensity": { "type": "number", "minimum": 0, "maximum": 100 },
        "remainingTicks": { "type": "integer", "minimum": 0, "description": "Ausente significa duração indefinida até que uma regra mude." },
        "sourceId": { "type": "string", "description": "Origem causal, para o log de R-048." }
      },
      "additionalProperties": false
    },

    "Covering": {
      "type": "object",
      "required": ["substanceId", "amount"],
      "description": "Substância que recobre tile, objeto ou parte de corpo. Persiste, é descrita textualmente e é perceptível por terceiros. É o principal canal do substrato físico para a cognição social. R-025.",
      "properties": {
        "substanceId": { "type": "string" },
        "amount": { "type": "number", "minimum": 0, "maximum": 100 },
        "freshness": { "type": "number", "minimum": 0, "maximum": 1, "description": "1 é recém-aplicada; 0 é completamente seca ou velha. Afeta remoção e descrição. R-026." },
        "appliedAtTick": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "Substance": {
      "type": "object",
      "required": ["id", "name", "vectors", "effects"],
      "description": "Material que carrega payload de efeitos sobre um corpo. Um mecanismo do qual saem veneno, álcool, remédio, droga, alergia e doença. R-029, R-030.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["contact", "inhalation", "ingestion", "injection"] },
          "description": "Por onde entra no corpo. R-030."
        },
        "contagious": { "type": "boolean", "description": "R-032." },
        "incubationTicks": { "type": "integer", "minimum": 0 },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "severity"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["damage", "pain", "nausea", "drowsiness", "unconsciousness", "healing", "disinhibition", "moodShift", "perceptionDistortion", "paranoia", "euphoria"],
                "description": "Os últimos são cognitivos e entram no contexto enviado ao modelo. R-031."
              },
              "severity": { "type": "number", "minimum": 0, "maximum": 100 },
              "delayTicks": { "type": "integer", "minimum": 0 },
              "durationTicks": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "TileType": {
      "type": "string",
      "enum": ["floor", "wall", "door", "window", "roof", "water", "road"]
    },

    "Tile": {
      "type": "object",
      "required": ["type", "materialId", "pos"],
      "properties": {
        "type": { "$ref": "#/$defs/TileType" },
        "materialId": { "type": "string" },
        "pos": { "$ref": "#/$defs/GridPos" },
        "rotation": { "type": "integer", "enum": [0, 90, 180, 270] },
        "integrity": { "type": "number", "minimum": 0, "maximum": 100 },
        "temperature": { "type": "number", "description": "R-007." },
        "state": {
          "type": "object",
          "description": "Propriedades mecânicas do tipo de tile. Estado físico transitório não vive aqui — vive em states. W-006.",
          "properties": {
            "isOpen": { "type": "boolean" },
            "isLocked": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/TransientState" },
          "description": "R-004."
        },
        "coverings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Covering" },
          "description": "R-025."
        },
        "liquid": {
          "type": "object",
          "description": "Poça sobre o tile, medida em volume e possivelmente composta. R-020, R-021.",
          "properties": {
            "totalVolume": { "type": "number", "minimum": 0 },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["materialId", "volume"],
                "properties": {
                  "materialId": { "type": "string" },
                  "volume": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "gas": {
          "type": "object",
          "description": "Camada gasosa da célula. R-023.",
          "properties": {
            "materialId": { "type": "string" },
            "density": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "sectorId": { "type": "string" },
        "locationLabel": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Affordance": {
      "type": "string",
      "description": "Ação que o objeto declara suportar. Alimenta as opções apresentadas ao agente e ao GM."
    },

    "ObjectDef": {
      "type": "object",
      "required": ["id", "name", "description", "category", "materialId", "size", "affordances"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["tool", "furniture", "decoration", "consumable", "container", "clothing", "weapon"] },
        "materialId": { "type": "string" },
        "size": {
          "type": "object",
          "required": ["w", "h"],
          "properties": { "w": { "type": "integer" }, "h": { "type": "integer" } },
          "additionalProperties": false
        },
        "grabbable": { "type": "boolean" },
        "equippable": { "type": "boolean" },
        "slot": { "type": "string", "enum": ["hand", "worn", "none"] },
        "isContainer": { "type": "boolean" },
        "containerCapacity": { "type": "integer" },
        "affordances": { "type": "array", "items": { "$ref": "#/$defs/Affordance" } },
        "customProperties": { "type": "object", "additionalProperties": true },
        "userCreated": { "type": "boolean", "description": "Criado pelo usuário no modo construção. W-034." }
      },
      "additionalProperties": false
    },

    "WorldObject": {
      "type": "object",
      "required": ["id", "defId", "pos"],
      "properties": {
        "id": { "type": "string" },
        "defId": { "type": "string" },
        "pos": { "$ref": "#/$defs/Vec2" },
        "rotation": { "type": "number" },
        "integrity": { "type": "number", "minimum": 0, "maximum": 100 },
        "containedBy": { "type": ["string", "null"], "description": "id de container ou de agente que carrega." },
        "contents": { "type": "array", "items": { "type": "string" } },
        "temperature": { "type": "number", "description": "R-007." },
        "states": { "type": "array", "items": { "$ref": "#/$defs/TransientState" }, "description": "R-004." },
        "coverings": { "type": "array", "items": { "$ref": "#/$defs/Covering" }, "description": "R-025." },
        "wear": { "type": "number", "minimum": 0, "maximum": 100, "description": "Desgaste acumulado por uso, distinto de integridade. R-028." },
        "state": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },

    "Biology": {
      "type": "object",
      "description": "Estado biológico do agente. Quase tudo aqui é derivado de partes e condições — ver SPEC-B.",
      "required": ["age", "needs", "parts", "conditions", "capacities", "isAlive"],
      "properties": {
        "age": { "type": "number" },
        "needs": {
          "type": "object",
          "description": "Escalares que decaem com o tempo. Cruzar o limiar crítico gera uma condição, em vez de aplicar efeito direto. B-019.",
          "required": ["hunger", "thirst", "energy", "hygiene"],
          "properties": {
            "hunger": { "type": "number", "minimum": 0, "maximum": 100 },
            "thirst": { "type": "number", "minimum": 0, "maximum": 100 },
            "energy": { "type": "number", "minimum": 0, "maximum": 100 },
            "hygiene": { "type": "number", "minimum": 0, "maximum": 100 },
            "bladder": { "type": "number", "minimum": 0, "maximum": 100 },
            "comfort": { "type": "number", "minimum": 0, "maximum": 100 },
            "social": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "bodyTemperature": { "type": "number", "description": "Graus Celsius. Participa do sistema térmico do mundo. B-018, R-007." },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/BodyPartState" },
          "description": "Vetor de tamanho fixo, indexado por posição conforme config/body.json. B-001, B-038."
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Condition" },
          "description": "Ferimento, doença, cicatriz, prótese, efeito de substância, condição crônica e estado mental — tudo aqui. B-006."
        },
        "capacities": { "$ref": "#/$defs/Capacities" },
        "coverings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Covering" },
          "description": "Sangue, fuligem, lama. Perceptível por terceiros. R-025, B-032."
        },
        "isAlive": {
          "type": "boolean",
          "x-derived": true,
          "description": "DERIVADO de partes vitais destruídas e capacidades vitais zeradas. O GM nunca escreve aqui: para matar, destrói uma parte vital ou aplica condição fatal, e a morte vem com cadeia causal. B-029, B-036."
        },
        "causeOfDeath": { "type": "string", "description": "Preenchido na morte, com a cadeia causal registrada à parte. B-029." }
      },
      "additionalProperties": false
    },

    "BodyPartState": {
      "type": "object",
      "required": ["partId", "health"],
      "description": "Estado corrente de uma parte. A definição — cobertura, vitalidade, material inicial, capacidades servidas — vive em config/body.json. B-002.",
      "properties": {
        "partId": { "type": "string" },
        "health": { "type": "number", "minimum": 0, "description": "Zero destrói a parte e cascateia para os filhos. B-004." },
        "materialId": {
          "type": "string",
          "description": "Material corrente da parte, referenciando o mesmo catálogo dos tiles. Ausente significa o material inicial declarado em config/body.json. Presente e divergente significa que a parte foi transmutada, e todas as consequências — resistência a dano, limiares térmicos, densidade, capacidade de cicatrizar — passam a vir daqui. B-003, B-038, B-039."
        },
        "destroyed": { "type": "boolean" },
        "missing": { "type": "boolean", "description": "Destruída e removida, distinto de apenas ferida." },
        "prostheticId": { "type": "string", "description": "Substituição artificial, com eficiência própria. B-005." }
      },
      "additionalProperties": false
    },

    "Condition": {
      "type": "object",
      "required": ["defId", "severity"],
      "description": "A unidade única de saúde. B-006, B-007.",
      "properties": {
        "defId": { "type": "string", "description": "Entrada em config/conditions.json." },
        "partId": { "type": "string", "description": "Ausente significa condição de corpo inteiro." },
        "severity": { "type": "number", "minimum": 0, "maximum": 1 },
        "stage": { "type": "integer", "minimum": 0, "description": "DERIVADO da severidade pelos limiares declarados. B-008." },
        "immunity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Só em condições que correm contra imunidade. A primeira das duas a chegar a 1 vence. B-024." },
        "bleedRate": { "type": "number", "minimum": 0, "description": "Contribuição para a perda de sangue. B-017." },
        "tendQuality": { "type": "number", "minimum": 0, "maximum": 1.3, "description": "Qualidade do último tratamento. B-025." },
        "tendedAtTick": { "type": "integer" },
        "onsetTick": { "type": "integer" },
        "permanent": { "type": "boolean", "description": "Cicatriz, prótese, membro faltando. Cadência estática, custo zero. B-010, B-023." },
        "sourceId": { "type": "string", "description": "Quem ou o que causou. Alimenta o log causal e a atribuição social. R-048." }
      },
      "additionalProperties": false
    },

    "Capacities": {
      "type": "object",
      "x-derived": true,
      "description": "TODAS DERIVADAS. Nunca atribuídas diretamente, nem pela engine nem pelo GM. Recalculadas por invalidação, quando o conjunto de partes vivas e condições ativas muda — nunca a cada tick. Uma mutação do GM que aponte para cá é rejeitada pelo validador, que sugere qual condição produz o efeito pretendido. B-012, B-015, B-036.",
      "required": ["consciousness", "moving", "manipulation"],
      "properties": {
        "pain": { "type": "number", "minimum": 0, "maximum": 1, "description": "Soma das dores das condições, modulada pelo limiar de dor da personalidade. B-016." },
        "consciousness": { "type": "number", "minimum": 0, "maximum": 1, "description": "Multiplicador global. Depende de cérebro, bombeamento, respiração, filtragem e dor. Abaixo do limiar de desmaio o agente cai; em zero, morre. Seleciona o tier de LLM. B-013, B-014." },
        "sight": { "type": "number", "minimum": 0 },
        "hearing": { "type": "number", "minimum": 0 },
        "moving": { "type": "number", "minimum": 0 },
        "manipulation": { "type": "number", "minimum": 0 },
        "talking": { "type": "number", "minimum": 0 },
        "breathing": { "type": "number", "minimum": 0, "description": "Vital." },
        "bloodPumping": { "type": "number", "minimum": 0, "description": "Vital." },
        "bloodFiltration": { "type": "number", "minimum": 0, "description": "Vital. Governa a velocidade de ganho de imunidade. B-024." },
        "digestion": { "type": "number", "minimum": 0, "description": "Vital." },
        "metabolism": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },

    "Personality": {
      "type": "object",
      "description": "A-020. Traços numéricos guiam mecânica; o texto guia tom.",
      "required": ["traitsText", "bigFive", "custom"],
      "properties": {
        "traitsText": { "type": "string", "description": "2 a 4 frases. Editável pelo usuário." },
        "bigFive": {
          "type": "object",
          "required": ["openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism"],
          "properties": {
            "openness": { "type": "number", "minimum": 0, "maximum": 100 },
            "conscientiousness": { "type": "number", "minimum": 0, "maximum": 100 },
            "extraversion": { "type": "number", "minimum": 0, "maximum": 100 },
            "agreeableness": { "type": "number", "minimum": 0, "maximum": 100 },
            "neuroticism": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "custom": {
          "type": "object",
          "properties": {
            "stubbornness": { "type": "number", "minimum": 1, "maximum": 10, "description": "Base do limiar de teimosia. C-027." },
            "honesty": { "type": "number", "minimum": 0, "maximum": 100, "description": "Modula relato verbal. C-019." },
            "aggression": { "type": "number", "minimum": 0, "maximum": 100 },
            "empathy": { "type": "number", "minimum": 0, "maximum": 100 },
            "curiosity": { "type": "number", "minimum": 0, "maximum": 100 },
            "laziness": { "type": "number", "minimum": 0, "maximum": 100 },
            "bravery": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "Skills": {
      "type": "object",
      "description": "A-022. Alimenta MaxTurns de conversa e seleção de comitê.",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 },
      "examples": [{ "social": 45, "construcao": 70, "medicina": 20, "cozinha": 55, "combate": 30, "artesanato": 60, "agricultura": 40 }]
    },

    "Opinion": {
      "type": "object",
      "description": "C-022.",
      "required": ["id", "kind", "targetId", "nuanceDescription", "dissonanceBuffer", "stubbornnessThreshold", "currentThreshold"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["general", "social"] },
        "targetId": { "type": "string", "description": "Conceito ou id de agente." },
        "targetLabel": { "type": "string" },
        "nuanceDescription": { "type": "string", "description": "1 a 3 frases ATEMPORAIS. C-024." },
        "dissonanceBuffer": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "intensity", "simTime"],
            "properties": {
              "text": { "type": "string" },
              "intensity": { "type": "integer", "minimum": 1, "maximum": 3 },
              "simTime": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "stubbornnessThreshold": { "type": "integer", "description": "Valor base, derivado da personalidade." },
        "currentThreshold": { "type": "integer", "description": "Base mais acréscimos por sinergia. C-028." },
        "lastBurstSimTime": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },

    "MemoryEntry": {
      "type": "object",
      "required": ["id", "layer", "text", "simTime"],
      "properties": {
        "id": { "type": "string" },
        "layer": { "type": "string", "enum": ["short_term", "daily", "seasonal", "annual", "quinquennial", "decadal", "era"] },
        "text": { "type": "string" },
        "simTime": { "type": "number", "description": "Quando o período coberto começou." },
        "isMarcante": { "type": "boolean", "description": "Sobe intacto pelas camadas. C-013." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Ex: gm_denial, action_blocked, trauma." },
        "userCreated": { "type": "boolean" },
        "social": { "type": "string", "description": "Só em camadas longas: parágrafos focados em relações." }
      },
      "additionalProperties": false
    },

    "ActivityLogEntry": {
      "type": "object",
      "description": "C-010. Privado. Fonte da verdade contra a qual mentiras são comparadas.",
      "required": ["simTime", "action", "sectorId"],
      "properties": {
        "simTime": { "type": "number" },
        "action": { "type": "string" },
        "targetId": { "type": ["string", "null"] },
        "sectorId": { "type": "string", "description": "Base da corroboração cruzada. C-020." },
        "verdict": { "type": "string", "enum": ["executed", "partial", "reinterpreted", "denied"] },
        "outcome": { "type": "string" }
      },
      "additionalProperties": false
    },

    "Goal": {
      "type": "object",
      "required": ["level", "text"],
      "properties": {
        "level": { "type": "string", "enum": ["primary", "secondary", "tertiary", "whim"] },
        "text": { "type": "string" },
        "rationale": { "type": "string" },
        "setAtSimTime": { "type": "number" },
        "expiresAtSimTime": { "type": ["number", "null"], "description": "Usado por caprichos." },
        "userCreated": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "InventorySlot": {
      "type": "object",
      "required": ["slot"],
      "properties": {
        "slot": { "type": "string", "enum": ["hand_left", "hand_right", "worn", "backpack"] },
        "objectIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "Relationship": {
      "type": "object",
      "required": ["targetId", "sentiment"],
      "properties": {
        "targetId": { "type": "string" },
        "sentiment": { "type": "number", "minimum": -100, "maximum": 100 },
        "kind": { "type": "string", "description": "Ex: irmão, cônjuge, rival, colega." },
        "opinionId": { "type": ["string", "null"], "description": "Aponta para a opinião social textual correspondente." }
      },
      "additionalProperties": false
    },

    "Routine": {
      "type": "object",
      "description": "A-020. Sempre acessível ao contexto de pensamento.",
      "properties": {
        "wakeHour": { "type": "number" },
        "sleepHour": { "type": "number" },
        "workStartHour": { "type": "number" },
        "workEndHour": { "type": "number" },
        "role": { "type": "string", "description": "Função na comunidade. A-021." },
        "assignedTasks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "Agent": {
      "type": "object",
      "required": ["id", "name", "pos", "rotation", "biology", "personality", "skills"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "appearanceDescription": { "type": "string" },
        "pos": { "$ref": "#/$defs/Vec2", "description": "Contínua, não travada ao grid. W-002." },
        "rotation": { "type": "number", "description": "Graus. Independente da direção de movimento." },
        "moveSpeed": { "type": "number", "description": "Tiles por minuto simulado." },
        "vision": {
          "type": "object",
          "properties": {
            "angle": { "type": "number", "description": "Graus de abertura do cone." },
            "range": { "type": "number", "description": "Tiles." }
          },
          "additionalProperties": false
        },
        "hearingRange": { "type": "number" },
        "biology": { "$ref": "#/$defs/Biology" },
        "personality": { "$ref": "#/$defs/Personality" },
        "skills": { "$ref": "#/$defs/Skills" },
        "inventory": { "type": "array", "items": { "$ref": "#/$defs/InventorySlot" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/Relationship" } },
        "opinions": { "type": "array", "items": { "$ref": "#/$defs/Opinion" } },
        "memories": { "type": "array", "items": { "$ref": "#/$defs/MemoryEntry" } },
        "activityLog": { "type": "array", "items": { "$ref": "#/$defs/ActivityLogEntry" } },
        "goals": {
          "type": "object",
          "properties": {
            "primary": { "$ref": "#/$defs/Goal" },
            "secondary": { "$ref": "#/$defs/Goal" },
            "tertiary": { "$ref": "#/$defs/Goal" },
            "whim": { "type": ["object", "null"], "$ref": "#/$defs/Goal" },
            "deprecated": { "type": ["object", "null"], "$ref": "#/$defs/Goal" }
          },
          "additionalProperties": false
        },
        "routine": { "$ref": "#/$defs/Routine" },
        "currentThought": { "type": ["string", "null"] },
        "flags": {
          "type": "array",
          "items": { "type": "string", "enum": ["sleeping", "thinking", "in_conversation", "combat", "unconscious", "dead", "paused"] }
        },
        "llmBudgetUsedToday": { "type": "integer" }
      },
      "additionalProperties": false
    },

    "CommunityLaw": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "enactedAtSimTime": { "type": "number" },
        "sourceMeetingId": { "type": "string" }
      },
      "additionalProperties": false
    },

    "WorldMutation": {
      "type": "object",
      "description": "G-005. Alteração concreta emitida pelo GM.",
      "required": ["type", "target", "changes"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["agent_state", "tile_state", "object_state", "inventory", "relationship", "global_event", "spawn_object", "destroy_object", "community_mechanic", "engine_effect"]
        },
        "target": { "type": "string" },
        "changes": {
          "type": "object",
          "additionalProperties": true,
          "description": "Campos alterados. O validador rejeita qualquer caminho marcado com x-derived neste schema — capacidades, isAlive, estágio de condição — porque são recalculados e a escrita seria um no-op silencioso. O GM muta causa; a engine deriva o resto. B-036."
        },
        "effectId": {
          "type": "string",
          "description": "Obrigatório quando type é engine_effect. Identificador do vocabulário fechado de R-015 — para tiles, objetos e partes de corpo, incluindo transmute — ou de B-037, para as operações biológicas. A partir da invocação a engine assume a simulação. Sujeito ao registro de plausibilidade do cenário. R-043, B-037, B-044."
        },
        "targetPartId": {
          "type": "string",
          "description": "Parte do corpo alvo, quando o efeito incide sobre um agente. Ausente significa corpo inteiro. B-037."
        },
        "rationale": { "type": "string", "description": "Justificativa auditável. G-020. Em engine_effect, deve explicar por que nenhuma regra da matriz de reação ou de lesão já cobria o caso. R-044, B-043." }
      },
      "additionalProperties": false
    },

    "Clock": {
      "type": "object",
      "required": ["simTime", "speed", "paused"],
      "properties": {
        "simTime": { "type": "number", "description": "Minutos simulados desde o início." },
        "speed": { "type": "integer", "enum": [0, 1, 2, 4, 8] },
        "paused": { "type": "boolean" },
        "day": { "type": "integer" },
        "season": { "type": "integer" },
        "year": { "type": "integer" }
      },
      "additionalProperties": false
    }
  }
}
