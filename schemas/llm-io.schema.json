{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulador-interacoes/schemas/llm-io.schema.json",
  "title": "Contratos de saída dos prompts",
  "description": "Fonte única. Substitui prompts/_shared/output_schemas.json. Cada prompt referencia um destes por nome no prompt_registry.yaml; o trecho relevante é injetado no prompt em tempo de renderização e usado para validar a resposta.",

  "$defs": {

    "agent_thought_response": {
      "type": "object",
      "required": ["thought", "decision"],
      "properties": {
        "thought": { "type": "string", "description": "Monólogo interior in-character." },
        "decision": {
          "type": "object",
          "required": ["actionType", "intentDescription"],
          "properties": {
            "actionType": {
              "type": "string",
              "enum": ["move", "interact", "speak", "wait", "sleep", "eat", "drink", "work", "follow", "flee", "attack", "use_item", "pick_up", "drop", "give", "open_conversation", "none"]
            },
            "targetId": { "type": ["string", "null"] },
            "targetLabel": { "type": ["string", "null"] },
            "destination": { "type": ["object", "null"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
            "intentDescription": { "type": "string", "description": "Linguagem natural, é o que o GM lê." },
            "speech": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "memorability": {
          "type": "object",
          "description": "C-053. O quanto este instante marcou o agente, avaliado por ele no instante em que o viveu — não por um modelo relendo o dia depois. A engine compara a nota ao limiar derivado de consciência e atenção: acima, o texto vira memória; abaixo, nada acontece e o instante se perde, que é o comportamento correto. Custa zero chamada porque vem na mesma resposta que já decidiu a ação.",
          "required": ["score"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 10 },
            "what": { "type": "string", "description": "O fato que marcou, numa frase e em primeira pessoa. Só preenchido quando a nota é diferente de zero — é o texto que vira memória se passar do limiar." }
          },
          "additionalProperties": false
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestedDeepThinking": { "type": "boolean", "description": "C-051. Só oferecido quando o orçamento de pensamento profundo do agente é maior que zero e ainda tem saldo." },
            "emotion": { "type": "string" },
            "urgency": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "personality_drift_response": {
      "description": "A-021. Deltas pequenos. O texto só muda se algum traço cruzar limiar.",
      "type": "object",
      "required": ["deltas"],
      "properties": {
        "deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["trait", "delta", "reason"],
            "properties": {
              "trait": { "type": "string" },
              "delta": { "type": "number", "minimum": -3, "maximum": 3 },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "newTraitsText": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "nightly_appraisal_response": {
      "description": "C-047 e C-025. A apreciação noturna: uma só chamada resolve o Crivo e a passagem noturna da classificação de dissonância. As duas tarefas leem o mesmo material do dia contra o mesmo contexto pessoal, e mantê-las separadas pagaria uma chamada por agente por noite apenas para renderizar esse contexto duas vezes.\n\nAs duas listas referenciam as definições originais por ponteiro, e não por cópia, para que não possam divergir. A passagem a quente da classificação vive em `post_conversation_response`, logo ao fim da conversa, porque a ruptura precisa poder acontecer no mesmo dia; com as duas cadências fundidas nos hospedeiros, o prompt `cognition.dissonance_classifier` foi aposentado.",
      "type": "object",
      "required": ["classifications", "verdicts"],
      "properties": {
        "classifications": { "$ref": "#/$defs/dissonance_classification_response/properties/classifications" },
        "verdicts": { "$ref": "#/$defs/sieve_response/properties/verdicts" }
      },
      "additionalProperties": false
    },

    "memory_summary_response": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "preservedMarcantes": { "type": "array", "items": { "type": "string" } },
        "discardedTopics": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "longterm_memory_response": {
      "description": "C-017. Um schema para anual, quinquenal, decadal e era. O nível é variável de entrada.",
      "type": "object",
      "required": ["general", "social", "marcantes"],
      "properties": {
        "general": { "type": "string", "description": "Dois parágrafos atemporais." },
        "social": { "type": "string", "description": "Dois parágrafos sobre relações." },
        "marcantes": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "dissonance_classification_response": {
      "description": "C-025. Uma chamada cobre todas as impressões contra todas as opiniões. Pares sem relação são omitidos.",
      "type": "object",
      "required": ["classifications"],
      "properties": {
        "classifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["impressionId", "opinionId", "relation", "intensity"],
            "properties": {
              "impressionId": { "type": "string" },
              "opinionId": { "type": "string" },
              "relation": { "type": "string", "enum": ["conflito", "sinergia"] },
              "intensity": { "type": "integer", "minimum": 1, "maximum": 3 },
              "reason": { "type": "string", "maxLength": 200 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "sieve_response": {
      "description": "C-047. O Crivo. Tudo que o agente ouviu no período é destrinchado em temas e cada tema recebe um veredito à luz do contexto pessoal e do texto original. Roda em lote, uma chamada por agente por noite, junto do resto do lote — por tema seria o pior perfil de volume possível.",
      "type": "object",
      "required": ["verdicts"],
      "properties": {
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "verdict"],
            "properties": {
              "claim": { "type": "string", "description": "O tema afirmado, numa frase, extraído do que foi dito." },
              "topic": { "type": "string" },
              "sourceAgentId": { "type": ["string", "null"] },
              "verdict": { "$ref": "domain.schema.json#/$defs/SieveVerdict" },
              "reason": {
                "type": "string",
                "maxLength": 200,
                "description": "Por que este agente, com esta memória e esta personalidade, reage assim. É o que distingue descartar por tédio de descartar de propósito."
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "self_understanding_response": {
      "description": "C-050. Como o agente se vê agora, a partir do que viveu desde a última vez. Gerado esporadicamente, cadência em tuning.",
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "description": "Primeira pessoa, atemporal, dentro do teto de palavras de tuning." },
        "changedFromPrevious": { "type": "boolean", "description": "Falso quando nada mudou, e nesse caso o auto-entendimento anterior é preservado sem gravar versão nova." },
        "changeSummary": { "type": "string", "description": "Uma frase sobre o que mudou. Alimenta a timeline e o export narrativo." }
      },
      "additionalProperties": false
    },

    "opinion_burst_response": {
      "type": "object",
      "required": ["newNuanceDescription", "stance"],
      "properties": {
        "newNuanceDescription": { "type": "string", "description": "1 a 3 frases atemporais." },
        "stance": {
          "type": "string",
          "enum": ["trust", "distrust", "admire", "pity", "resent", "indifferent", "fear", "desire", "neutral"],
          "description": "Compressão da nuance — viés relacional canônico."
        },
        "topic": { "type": "string", "description": "Tópico canônico para pré-filtro downstream." },
        "emotionalTone": { "type": "string" },
        "severity": { "type": "string", "enum": ["nuance_shift", "inversao"] }
      },
      "additionalProperties": false
    },

    "nightly_reflection_response": {
      "description": "C-031. Lote noturno das opiniões gerais.",
      "type": "object",
      "required": ["impressions"],
      "properties": {
        "impressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "topic": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "newOpinionCandidates": {
          "type": "array",
          "description": "Tópicos sobre os quais o agente ainda não tinha crença formada.",
          "items": {
            "type": "object",
            "required": ["targetLabel", "nuanceDescription"],
            "properties": {
              "targetLabel": { "type": "string" },
              "nuanceDescription": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "goal_revise_response": {
      "description": "C-040 a C-044. Um schema para toda revisão de meta, qualquer nível e qualquer gatilho.",
      "type": "object",
      "required": ["goalText", "rationale"],
      "properties": {
        "goalText": { "type": "string", "description": "Verbo mais objeto. Nada de meta vaga." },
        "rationale": { "type": "string" },
        "deprecatedReason": { "type": ["string", "null"] },
        "alsoRevise": {
          "type": "array",
          "description": "Níveis abaixo que a mudança invalidou.",
          "items": { "type": "string", "enum": ["secondary", "tertiary"] }
        }
      },
      "additionalProperties": false
    },

    "whim_response": {
      "description": "C-037. Retornar null quando nada puxa o agente.",
      "type": ["object", "null"],
      "required": ["whimText", "estimatedMinutes"],
      "properties": {
        "whimText": { "type": "string" },
        "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
        "trigger": { "type": "string", "enum": ["tedio", "traco", "memoria", "ambiente"] }
      },
      "additionalProperties": false
    },

    "handshake_response": {
      "description": "S-002.",
      "type": "object",
      "required": ["accept"],
      "properties": {
        "accept": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 200 },
        "openingLine": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "conversation_turn_response": {
      "type": "object",
      "required": ["dialogueText"],
      "properties": {
        "dialogueText": { "type": "string" },
        "relocationProposal": {
          "type": ["object", "null"],
          "properties": {
            "targetLocationLabel": { "type": "string" },
            "coordinates": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        },
        "endConversation": { "type": "boolean" },
        "requestExtension": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "relocation_vote_response": {
      "type": "object",
      "required": ["vote"],
      "properties": {
        "vote": { "type": "string", "enum": ["accept", "deny"] },
        "explanation": { "type": "string", "description": "Obrigatória em caso de deny. Vira fala." }
      },
      "additionalProperties": false
    },

    "post_conversation_response": {
      "description": "S-012, S-014, C-025. A apreciação a quente: tirar as impressões da conversa e classificá-las contra as opiniões de quem as teve, numa chamada só.\n\nEste prompt produzia só as impressões, e o classificador de dissonância era chamado logo em seguida para relê-las contra as mesmas opiniões — mesmo material, dois renders, uma chamada por participante por conversa. É a mesma fusão já feita para o lote noturno em `nightly_appraisal_response`, aplicada ao par que dispara com mais frequência.\n\nO agente classifica o que ele mesmo acabou de sentir, o que é mais fácil que classificar impressão alheia, e não mais difícil.",
      "type": "object",
      "required": ["rawImpressions", "sentimentDeltas", "classifications"],
      "properties": {
        "classifications": { "$ref": "#/$defs/dissonance_classification_response/properties/classifications" },
        "rawImpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "aboutAgentId": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "sentimentDeltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agentId", "delta"],
            "properties": {
              "agentId": { "type": "string" },
              "delta": { "type": "integer", "minimum": -10, "maximum": 10 }
            },
            "additionalProperties": false
          }
        },
        "unresolvedTopic": { "type": ["string", "null"], "description": "Gera intenção de retomar a conversa. S-011." }
      },
      "additionalProperties": false
    },

    "meeting_verdict_response": {
      "type": "object",
      "required": ["consensusNarrative", "goalOperations", "mechanicChanges"],
      "properties": {
        "meetingType": { "type": "string" },
        "consensusNarrative": { "type": "string" },
        "goalOperations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "text"],
            "properties": {
              "action": { "type": "string", "enum": ["add", "remove", "modify"] },
              "id": { "type": "string" },
              "text": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "mechanicChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "value", "rationale"],
            "properties": {
              "target": { "type": "string" },
              "value": { "type": "string" },
              "rationale": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "newLaws": { "type": "array", "items": { "type": "string" } },
        "dissent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agentId", "reason"],
            "properties": { "agentId": { "type": "string" }, "reason": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "generalization": {
      "description": "Promoção generalizada cross-domain (R-046, B-045). Regra provisória entra viva imediatamente.",
      "type": "object",
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": { "type": "string", "enum": ["systemic", "one_off"] },
        "domain": {
          "type": "string",
          "enum": ["substrate", "body", "social", "cognition", "community", "object"],
          "description": "Obrigatório quando verdict é systemic. O domínio `object` exige também o `defId` do alvo no corpo da regra. V-041."
        },
        "rule": {
          "type": "object",
          "description": "Presente só se verdict==systemic. Forma depende do domain — vocabulário fechado.",
          "additionalProperties": true
        },
        "reasoning": { "type": "string", "maxLength": 400 }
      },
      "additionalProperties": false
    },

    "gm_response": {
      "description": "V-004 e V-035. Postura permissiva fora dos domínios de porteiro: denied é último recurso e só é recuperável por nova tentativa dentro dos domínios declarados em ValidationPolicy. Emite consequences quando o desfecho não é certo, e generalization quando o julgamento generaliza.",
      "type": "object",
      "required": ["verdict", "narrative", "worldMutations", "agentFeedback", "generalization"],
      "properties": {
        "verdict": { "type": "string", "enum": ["executed", "partial", "reinterpreted", "denied"] },
        "narrative": { "type": "string", "description": "Terceira pessoa, para a timeline. O log causal de X-005 é o registro do que aconteceu; esta narrativa é só apresentação." },
        "reasoning": {
          "type": "string",
          "description": "V-037. O caminho que levou ao veredito: que propriedades foram consideradas, que capacidade de quem foi pesada, por que o desfecho é esse. Auditável e nunca mostrado ao agente."
        },
        "deniedDomain": {
          "type": "string",
          "enum": ["physicalLaw", "inviolableLaw", "userProhibition", "bodyIntegrity", "socialNorm", "resourceConservation"],
          "description": "Obrigatório quando verdict é denied. Se o domínio não consta em ValidationPolicy.gatekeeperDomains, a negação é final e não gera nova tentativa. V-036."
        },
        "worldMutations": {
          "type": "array",
          "items": { "$ref": "domain.schema.json#/$defs/WorldMutation" },
          "description": "Mutações certas — as que acontecem independentemente de rolagem."
        },
        "consequences": {
          "type": "array",
          "description": "V-038. Desfechos possíveis com probabilidade estimada. A engine rola com dado semeado em (simTime, agentId, actionId), então a partida continua reproduzível pelo cassete. A maior parte das ações não deveria produzir nada aqui: desfecho certo vai em worldMutations e não é sorteado.",
          "items": {
            "type": "object",
            "required": ["description", "probability", "mutations"],
            "properties": {
              "description": { "type": "string" },
              "probability": { "type": "integer", "minimum": 1, "maximum": 100 },
              "mutations": { "type": "array", "items": { "$ref": "domain.schema.json#/$defs/WorldMutation" } },
              "exclusiveGroup": {
                "type": "string",
                "description": "Desfechos do mesmo grupo são mutuamente exclusivos e suas probabilidades precisam somar 100. Desfechos sem grupo são rolados de forma independente."
              }
            },
            "additionalProperties": false
          }
        },
        "agentFeedback": { "type": "string", "description": "Sensorial e diegético. Nunca linguagem de sistema." },
        "generalization": { "$ref": "#/$defs/generalization" },
        "descriptionUpdate": {
          "type": "object",
          "description": "V-042. Informação que o julgamento revelou e que vale gravar na descrição do objeto, para poupar raciocínio nas próximas vezes. Sensorial é pública; funcional é oculta. V-042.",
          "properties": {
            "defId": { "type": "string" },
            "sensoryAddendum": { "type": "string" },
            "functionalAddendum": { "type": "string" }
          },
          "additionalProperties": false
        },
        "followUpAffordances": { "type": "array", "items": { "type": "string" }, "description": "Affordances que este julgamento passa a habilitar no alvo. V-041." },
        "isMarcanteCandidate": { "type": "boolean", "description": "V-019. Sinalização, não decisão: quem pontua o quanto marcou é o agente, em C-053." },
        "witnessIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "terrain_params_response": {
      "type": "object",
      "required": ["seed", "mapWidth", "mapHeight", "waterRatio", "biomePrimary", "climate", "urbanDensity", "scenarioNarrative"],
      "properties": {
        "seed": { "type": "integer" },
        "mapWidth": { "type": "integer", "minimum": 32, "maximum": 512, "description": "Em tiles de 0,5 m. O teto subiu de 128 porque a 0,5 m um grid de 128 daria um mundo de 64 m, menor que um quarteirão. W-001." },
        "mapHeight": { "type": "integer", "minimum": 32, "maximum": 512 },
        "waterRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "waterStyle": { "type": "string", "enum": ["lago", "rio", "costa", "pantano", "nenhum"] },
        "elevationVariance": { "type": "number", "minimum": 0, "maximum": 1 },
        "biomePrimary": { "type": "string", "enum": ["floresta", "planicie", "urbano", "costeiro", "arido", "montanhoso"] },
        "roadDensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "vegetationDensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "urbanDensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "climate": { "type": "string", "enum": ["temperado", "arido", "frio", "tropical"] },
        "dangerZones": { "type": "array", "items": { "type": "string" } },
        "scenarioNarrative": { "type": "string", "description": "2 a 3 frases. Alimenta o construtor e os perfis." },
        "inviolableLaws": { "type": "array", "items": { "type": "string" }, "description": "V-014. Regras do cenário que o GM não contorna." }
      },
      "additionalProperties": false
    },

    "agent_profile_response": {
      "type": "object",
      "required": ["name", "age", "appearanceDescription", "personality", "initialRole", "primaryGoalSeed", "secondaryGoalSeed", "skills", "voiceCard"],
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "appearanceDescription": { "type": "string" },
        "personality": { "$ref": "domain.schema.json#/$defs/Personality" },
        "voiceCard": { "$ref": "domain.schema.json#/$defs/VoiceCard" },
        "skills": { "$ref": "domain.schema.json#/$defs/Skills" },
        "initialRole": { "type": "string" },
        "primaryGoalSeed": { "type": "string" },
        "secondaryGoalSeed": { "type": "string" },
        "initialOpinions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["targetLabel", "nuanceDescription"],
            "properties": {
              "kind": { "type": "string", "enum": ["general", "social"] },
              "targetLabel": { "type": "string" },
              "nuanceDescription": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "relationshipSeeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["targetHint", "sentiment", "reason"],
            "properties": {
              "targetHint": { "type": "string" },
              "sentiment": { "type": "integer", "minimum": -100, "maximum": 100 },
              "kind": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "spawnPreference": { "type": "string", "enum": ["near_residential", "near_work", "central"] }
      },
      "additionalProperties": false
    },

    "item_definition": {
      "$ref": "domain.schema.json#/$defs/ObjectDef"
    }
  }
}
