{
  "name": "simulador-interacoes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador de interações sociais emergentes entre agentes movidos a LLM",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/sim-core",
    "packages/panel-web"
  ],
  "scripts": {
    "verify": "node scripts/validate-contracts.mjs",
    "types": "node scripts/generate-types.mjs",
    "build": "npm run build --workspace=@sim/core",
    "test": "npm run test --workspace=@sim/core",
    "test:watch": "npm run test:watch --workspace=@sim/core",
    "typecheck": "npm run typecheck --workspace=@sim/core",
    "sim": "npm run sim --workspace=@sim/core --",
    "check": "npm run verify && npm run types -- --check && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
