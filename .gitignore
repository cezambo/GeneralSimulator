# Dependências
node_modules/
.pnpm-store/

# Build
dist/
build/
*.tsbuildinfo

# Godot
.godot/
.import/
export_presets.cfg

# Segredos e config local
.env
.env.*
# Os *.example.json sao a referencia comentada e VAO para o versionamento; os
# arquivos reais, sem .example, sao os carregados em execucao e ficam de fora
# (config/README.md). Antes so models.json era ignorado, e tuning.json local
# teria entrado no repositorio junto da calibracao pessoal de quem o editou.
config/*.json
!config/*.example.json

# Saídas de execução
cassettes/
saves/
logs/
*.log

# Sistema operacional e editor
.DS_Store
Thumbs.db
.vscode/
.idea/
