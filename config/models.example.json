{
  "version": 2,
  "activePreset": "teste-barato",

  "providers": {
    "openrouter": {
      "type": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "headers": {
        "X-Title": "Simulador de Interacoes"
      }
    }
  },

  "presets": {
    "teste-barato": {
      "description": "Open-weights gratuitos. Para iterar em prompts sem custo.",
      "bindings": {
        "compact":   { "provider": "openrouter", "model": "openai/gpt-oss-20b:free",                "temperature": 0.2,  "maxTokens": 400 },
        "narrative": { "provider": "openrouter", "model": "google/gemma-4-26b-a4b-it:free",         "temperature": 0.85, "maxTokens": 1200, "reasoningEffort": "medium" },
        "longform":  { "provider": "openrouter", "model": "nvidia/nemotron-3-ultra-550b-a55b:free", "temperature": 0.6,  "maxTokens": 2000 }
      }
    },

    "equilibrado": {
      "description": "Barato onde o volume e alto, forte onde a narrativa importa.",
      "bindings": {
        "compact":   { "provider": "openrouter", "model": "inclusionai/ling-2.6-flash", "temperature": 0.2,  "maxTokens": 400 },
        "narrative": { "provider": "openrouter", "model": "qwen/qwen3.7-flash",         "temperature": 0.85, "maxTokens": 1200, "reasoningEffort": "high" },
        "longform":  { "provider": "openrouter", "model": "qwen/qwen3.7-flash",         "temperature": 0.6,  "maxTokens": 2000 }
      }
    },

    "qualidade": {
      "description": "Rodadas de avaliacao narrativa. Caro, usar em sessoes curtas.",
      "bindings": {
        "compact":   { "provider": "openrouter", "model": "openai/gpt-oss-20b",          "temperature": 0.2,  "maxTokens": 400 },
        "narrative": { "provider": "openrouter", "model": "anthropic/claude-opus-5",     "temperature": 0.85, "maxTokens": 1500, "reasoningEffort": "high" },
        "longform":  { "provider": "openrouter", "model": "anthropic/claude-opus-5",     "temperature": 0.6,  "maxTokens": 2500 }
      }
    }
  },

  "overrides": {},

  "routing": {
    "providerOrder": [],
    "allowFallbacks": true,
    "requireStructuredOutputs": true,
    "catalogCacheMinutes": 60
  },

  "budget": {
    "dailyUsdLimit": 5.0,
    "perAgentPerSimDayCallLimit": 32,
    "onExceed": "degrade"
  },

  "cassettes": {
    "mode": "hybrid",
    "directory": "cassettes"
  }
}
